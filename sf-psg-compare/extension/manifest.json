{
  "manifest_version": 3,
  "name": "Salesforce Capability Pack",
  "version": "0.5.0",
  "description": "Admin tools for Salesforce: compare permission set groups, see a user's access, see the territory and role hierarchy, explain why a user can see a record, and find which flows use an object, a field or a record Id. Read-only; uses your existing Salesforce login.",
  "permissions": ["cookies", "activeTab", "tabs"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.salesforce.mil/*",
    "https://*.cloudforce.mil/*",
    "https://*.sfcrmproducts.cn/*"
  ],
  "action": {
    "default_title": "Salesforce Capability Pack",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
