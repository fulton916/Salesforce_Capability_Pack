{
  "manifest_version": 3,
  "name": "Salesforce Capability Pack",
  "version": "0.4.0",
  "description": "Salesforce admin tools: compare permission set groups, see user access, view role trees, copy page details for a ticket. Read-only.",
  "permissions": ["cookies", "activeTab", "tabs"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.salesforce.mil/*",
    "https://*.cloudforce.mil/*",
    "https://*.sfcrmproducts.cn/*"
  ],
  "action": {
    "default_title": "Salesforce Capability Pack",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
