{
  "manifest_version": 3,
  "name": "Salesforce Capability Pack",
  "version": "0.5.0",
  "description": "Compare permission set groups, check user and record access, view role and territory trees, copy page details for tickets. Read-only",
  "permissions": ["cookies", "activeTab", "tabs"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.salesforce.mil/*",
    "https://*.cloudforce.mil/*",
    "https://*.sfcrmproducts.cn/*"
  ],
  "action": {
    "default_title": "Salesforce Capability Pack",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
