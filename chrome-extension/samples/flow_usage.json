   "def": {
    "id": "300000000000001AAA",
    "apiName": "Account_Status_Router",
    "label": "Account Status Router",
    "processType": "AutoLaunchedFlow",
    "triggerType": "RecordAfterSave",
    "triggerObject": "Account",
    "recordTriggerType": "Update",
    "isActive": true,
    "activeVersionId": "301000000000001AAA",
    "latestVersionId": "301000000000001AAA",
    "namespace": "",
    "managed": false,
    "triggerOrder": null,
    "lastModified": "2026-01-15T10:00:00.000+0000",
    "triggerObjectName": "Account",
    "hasAsyncPath": false
   },
   "versions": {
    "301000000000001AAA": {
     "metadata": {
      "start": {
       "object": "Account",
       "triggerType": "RecordAfterSave",
       "recordTriggerType": "Update",
       "filters": [
        {
         "field": "Status__c",
         "operator": "NotEqualTo",
         "value": {
          "stringValue": "Active"
         }
        }
       ]
      },
      "decisions": [
       {
        "name": "Is_Churned",
        "label": "Is churned?",
        "rules": [
         {
          "name": "Yes",
          "label": "Yes",
          "conditions": [
           {
            "leftValueReference": "$Record.Status__c",
            "operator": "EqualTo",
            "rightValue": {
             "stringValue": "Churned"
            }
           },
           {
            "leftValueReference": "$Record__Prior.Status__c",
            "operator": "EqualTo",
            "rightValue": {
             "stringValue": "Active"
            }
           }
          ]
         }
        ]
       }
      ],
      "recordLookups": [
       {
        "name": "Get_Contacts",
        "label": "Get Contacts",
        "object": "Contact",
        "filters": [
         {
          "field": "AccountId",
          "operator": "EqualTo",
          "value": {
           "elementReference": "$Record.Id"
          }
         },
         {
          "field": "Status__c",
          "operator": "EqualTo",
          "value": {
           "stringValue": "Open"
          }
         }
        ],
        "queriedFields": [
         "Status__c",
         "Email"
        ],
        "storeOutputAutomatically": true
       }
      ],
      "recordUpdates": [
       {
        "name": "Update_Account",
        "label": "Update Account",
        "object": "Account",
        "filters": [
         {
          "field": "Id",
          "operator": "EqualTo",
          "value": {
           "elementReference": "$Record.Id"
          }
         }
        ],
        "inputAssignments": [
         {
          "field": "Status__c",
          "operator": "EqualTo",
          "value": {
           "stringValue": "Closed"
          }
         },
         {
          "field": "Industry",
          "operator": "EqualTo",
          "value": {
           "stringValue": "Other"
          }
         }
        ]
       }
      ],
      "textTemplates": [
       {
        "name": "Note",
        "text": "Status is now {!$Record.Status__c} for {!$Record.Name}"
       }
      ]
     }
    }
   }
  },
