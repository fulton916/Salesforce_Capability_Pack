<!--
  First retrieve of every run: the permission set groups, and the permission sets and
  muting permission sets inside them. psg2csv_collect.py reads these local files to work
  out which fields each group can see.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>*</members>
        <name>MutingPermissionSet</name>
    </types>
    <types>
        <members>*</members>
        <name>PermissionSet</name>
    </types>
    <types>
        <members>*</members>
        <name>PermissionSetGroup</name>
    </types>
    <version>62.0</version>
</Package>
